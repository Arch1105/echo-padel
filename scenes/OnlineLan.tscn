[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/OnlineLan.gd" id="1"]

[node name="OnlineLan" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.06, 0.1, 0.14, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 30
text = "Play Online (LAN)"
accessibility_name = "Play online, local network"

[node name="NamePrompt" type="Label" parent="VBoxContainer"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2
custom_minimum_size = Vector2(420, 0)
text = "Enter your name. Your opponent will hear it announced during the match."
accessibility_name = "Enter your name. Your opponent will hear it announced during the match."

[node name="NameInput" type="LineEdit" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 44)
placeholder_text = "Player name"
accessibility_name = "Player name"
accessibility_description = "Type the name your opponent will hear during the match."

[node name="CreateRoomButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 52)
text = "Create Room"
accessibility_name = "Create Room"
accessibility_description = "Host a room. You'll be given a room code to share with the other player."

[node name="JoinRoomButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 52)
text = "Join Room"
accessibility_name = "Join Room"
accessibility_description = "Enter a room code the other player shared with you."

[node name="RoomCodePrompt" type="Label" parent="VBoxContainer"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2
custom_minimum_size = Vector2(420, 0)
visible = false
text = "Enter the room code the other player gave you."
accessibility_name = "Enter the room code the other player gave you."

[node name="RoomCodeInput" type="LineEdit" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 44)
visible = false
placeholder_text = "Room code"
accessibility_name = "Room code"
accessibility_description = "Type the room code the host shared with you, then press Connect."

[node name="ConnectButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 52)
visible = false
text = "Connect"
accessibility_name = "Connect"
accessibility_description = "Connect using the room code you entered."

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2
custom_minimum_size = Vector2(420, 0)
visible = false
text = "Waiting..."
accessibility_name = "Waiting..."

[node name="CopyCodeButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(280, 52)
visible = false
text = "Copy Room Code"
accessibility_name = "Copy Room Code"
accessibility_description = "Copy the room code to your clipboard so you can paste it into a text or chat message."

[node name="CancelButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(260, 52)
text = "Back"
accessibility_name = "Back"
accessibility_description = "Cancel and return to the main menu."
